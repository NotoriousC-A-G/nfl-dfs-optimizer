# Copy to .env and fill in. Never commit .env.

# PFF Developer API (developer.pff.com) — requires Chris's PFF Pro subscription
PFF_API_KEY=

# RotoGrinders — no public API; session captured via Claude in Chrome (see PRD Section 4)
ROTOGRINDERS_SESSION_COOKIE=

# Footballguys — no public API; session captured via Claude in Chrome (see PRD Section 4)
FOOTBALLGUYS_SESSION_COOKIE=

# Odds API (the-odds-api.com) — reuse the same key already used by the MLB DFS optimizer,
# the-odds-api.com covers all sports under one key/plan.
ODDS_API_KEY=

# Weather: Open-Meteo (primary) + NWS api.weather.gov (storm cross-check), same approach as
# the MLB build. Both are free and keyless — nothing to set here.

# DraftKings public API and nflverse/nfl-data-py need no credentials.
